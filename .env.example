# Copy this file to `.env` and fill in the blanks. `.env` is git-ignored.
# Never put real keys or passwords in this example file.

# --- Local Postgres (Docker) ---
POSTGRES_USER=counselor_admin
POSTGRES_PASSWORD=
POSTGRES_DB=counselor_insights

# --- App ---
APP_NAME="International Student Counseling"

# --- Analysis (Phase 1 runs on the mock) ---
LLM_MODE=mock
LLM_PROVIDER=bedrock
PROMPT_VERSION=3
LLM_TEMPERATURE=0.1
# Used only when LLM_MODE is not "mock" (needs AWS, later phases):
BEDROCK_MODEL_ID=

# --- Database connection (the app uses a limited, non-superuser login) ---
DB_HOST=localhost
DB_PORT=5433
APP_DB_USER=app_user
APP_DB_PASSWORD=

# --- Login (local development only) ---
# "dev" = fake counselors for local work. It can never be enabled in a production build.
AUTH_MODE=dev

# --- Audio storage and transcription ---
# Local development: recordings go in a folder on your computer and a fake transcriber is used.
# Both are refused in a production build. Real S3 and AssemblyAI are set up later (docs/AWS_SETUP.md).
STORAGE_MODE=local
LOCAL_STORAGE_SECRET=
TRANSCRIPTION_MODE=mock
APP_BASE_URL=http://localhost:3000
# Secret header AssemblyAI sends back on its webhook call. Make up a long random string.
ASSEMBLYAI_WEBHOOK_SECRET=
# Used only when TRANSCRIPTION_MODE=assemblyai. NEVER put the real key in this file:
# it is stored in AWS Secrets Manager when deployed.
ASSEMBLYAI_API_KEY=
# Used only when STORAGE_MODE=s3:
S3_AUDIO_BUCKET=
AWS_REGION=us-east-2

# --- When the prototype switches itself off ---
# Active through the END of this day (Pacific time). After it, every page, form and upload is refused.
# Class project due Dec 2, 2026; deactivated after Dec 15, 2026. If this is missing, Dec 15 applies.
APP_ACTIVE_UNTIL=2026-12-15

# --- Real sign-in (AWS Cognito). Used when AUTH_MODE=cognito (deployed). Filled in from the deploy output. ---
# None of these is a secret. The app client is a public client using PKCE, so there is no client secret.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# The hosted sign-in domain, for example your-prefix.auth.us-east-2.amazoncognito.com
COGNITO_DOMAIN=

# --- Deployed database connection (set by the infrastructure, not by hand) ---
# DB_SSL=require makes the connection encrypted (AWS RDS requires it). Leave unset locally.
DB_SSL=
